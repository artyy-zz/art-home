{
  "name": "arthome",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:money": "tsx scripts/money-rounding-check.ts",
    "seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:permissions:generate": "tsx scripts/generate-supabase-permissions.ts --write",
    "db:permissions:check": "tsx scripts/generate-supabase-permissions.ts --check",
    "db:permissions:apply": "npm run db:permissions:generate && prisma db execute --schema prisma/schema.prisma --file prisma/supabase/public-schema-permissions.sql",
    "db:push": "prisma db push && npm run db:permissions:apply",
    "db:migrate:dev": "prisma migrate dev && npm run db:permissions:apply",
    "db:migrate:deploy": "prisma migrate deploy && npm run db:permissions:apply",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.17.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
