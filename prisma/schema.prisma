generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Locale {
  sq
  en
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum PermissionModule {
  DASHBOARD
  LEADS
  CLIENTS
  SUPPLIERS
  INVENTORY
  ASSETS_INVENTORY
  STOQET
  OFFERS
  INVOICES
  PURCHASE_INVOICES
  DELIVERY_NOTES
  EXPENSES
  DEBIT_NOTES
  REPORTS
  WORKER_HOURS
  USERS
  ROLES
  SETTINGS
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  EXPORT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum QuoteRequestStatus {
  NEW
  REVIEWED
  COMPLETED
}

enum FurnitureCategory {
  KITCHENS
  TABLES
  WARDROBES
  CUSTOM
}

enum MaterialType {
  WOOD
  HARDWARE
  COMPONENT
  FINISH
  ACCESSORY
}

enum Unit {
  PCS
  METER
  SQM
  KG
  SET
}

enum InventoryMovementKind {
  RESTOCK
  CONSUMPTION
  ADJUSTMENT
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum DeliveryNoteType {
  SALES
  PURCHASE
}

enum DeliveryNoteStatus {
  DRAFT
  DELIVERED
  CANCELLED
}

enum ExpenseCategory {
  FUEL
  FOOD
  TRANSPORT
  MAINTENANCE
  OFFICE
  OTHER
}

enum DebitNoteReason {
  ITEM_RETURNED
  PRICE_CORRECTION
  DAMAGED_ITEM
  ORDER_ADJUSTMENT
  OTHER
}

enum NotificationType {
  LOW_STOCK
  UNPAID_INVOICE
  LEAD
  SYSTEM
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  role         UserRole         @default(STAFF)
  roleId       String?
  roleRecord   Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permissions  UserPermission[]

  @@index([roleId])
  @@index([createdAt])
  @@index([name])
  @@index([role, name])
}

model Role {
  id          String           @id @default(cuid())
  key         String?          @unique
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  isOwner     Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id         String           @id @default(cuid())
  role       UserRole?
  roleId     String?
  module     PermissionModule
  action     PermissionAction
  allowed    Boolean          @default(false)
  updatedAt  DateTime         @updatedAt
  roleRecord Role?            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([role, module, action])
  @@unique([roleId, module, action])
  @@index([role])
  @@index([roleId])
}

model UserPermission {
  id        String           @id @default(cuid())
  userId    String
  module    PermissionModule
  action    PermissionAction
  allowed   Boolean          @default(false)
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, action])
  @@index([userId])
}

model Client {
  id            String         @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  nui           String?
  vatNumber     String?
  vatRate       Float          @default(18)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leads         Lead[]
  offers        Offer[]
  invoices      Invoice[]
  deliveryNotes DeliveryNote[]
  debitNotes    DebitNote[]

  @@index([deletedAt])
  @@index([deletedAt, name])
  @@index([deletedAt, email])
  @@index([deletedAt, phone])
  @@index([createdAt])
}

model Supplier {
  id               String            @id @default(cuid())
  name             String
  contactPerson    String?
  email            String?
  phone            String?
  address          String?
  nui              String?
  vatNumber        String?
  vatRate          Float             @default(18)
  notes            String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseInvoices PurchaseInvoice[]
  deliveryNotes    DeliveryNote[]

  @@index([deletedAt])
  @@index([deletedAt, name])
  @@index([deletedAt, email])
  @@index([deletedAt, phone])
  @@index([createdAt])
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  phone        String
  email        String
  description  String
  status       LeadStatus @default(NEW)
  sourceLocale Locale     @default(sq)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  offers       Offer[]

  @@index([status, createdAt])
  @@index([clientId])
}

model QuoteRequest {
  id           String             @id @default(cuid())
  name         String
  phone        String?
  email        String?
  details      String
  status       QuoteRequestStatus @default(NEW)
  sourceLocale Locale             @default(sq)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([name])
  @@index([email])
  @@index([phone])
}

model Material {
  id                String                @id @default(cuid())
  name              String
  sku               String                @unique
  type              MaterialType
  unit              Unit
  stockQuantity     Float
  lowStockThreshold Float
  costPerUnitCents  Int
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  bomItems          ProductBomItem[]
  offerItems        OfferItem[]
  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseInvoiceItem[]
  deliveryNoteItems DeliveryNoteItem[]
  movements         InventoryMovement[]
  stokItems         StokArtikull[]

  @@index([type, name])
  @@index([name])
  @@index([stockQuantity, name])
  @@index([lowStockThreshold])
  @@index([costPerUnitCents])
  @@index([createdAt])
}

model Stok {
  id         String         @id @default(cuid())
  name       String
  priceCents Int
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      StokArtikull[]

  @@index([name])
  @@index([createdAt])
  @@index([priceCents])
}

model StokArtikull {
  id         String   @id @default(cuid())
  quantity   Float
  createdAt  DateTime @default(now())
  stokId     String
  materialId String
  stok       Stok     @relation(fields: [stokId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([stokId, materialId])
  @@index([materialId])
}

model AssetInventory {
  id           String   @id @default(cuid())
  name         String
  quantity     Float
  valueCents   Int
  purchaseDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([quantity])
  @@index([valueCents])
  @@index([purchaseDate])
}

model Product {
  id              String            @id @default(cuid())
  slug            String            @unique
  nameSq          String
  nameEn          String
  category        FurnitureCategory
  summarySq       String
  summaryEn       String
  descriptionSq   String
  descriptionEn   String
  dimensions      String?
  materialNotesSq String?
  materialNotesEn String?
  featured        Boolean           @default(false)
  basePriceCents  Int
  laborCostCents  Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bomItems        ProductBomItem[]
  offerItems      OfferItem[]
  invoiceItems    InvoiceItem[]

  @@index([category, featured])
}

model ProductBomItem {
  id         String   @id @default(cuid())
  quantity   Float
  createdAt  DateTime @default(now())
  productId  String
  materialId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([productId, materialId])
  @@index([materialId])
}

model Offer {
  id             String      @id @default(cuid())
  number         String      @unique
  status         OfferStatus @default(PENDING)
  currency       String      @default("EUR")
  notes          String?
  subtotalCents  Int
  vatEnabled     Boolean     @default(true)
  vatRate        Float       @default(18)
  vatAmountCents Int
  totalCents     Int
  validUntil     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  clientId       String
  leadId         String?
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead           Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items          OfferItem[]
  invoice        Invoice?

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([validUntil])
  @@index([totalCents])
  @@index([clientId, createdAt])
  @@index([leadId])
}

model OfferItem {
  id             String    @id @default(cuid())
  productName    String
  description    String?
  quantity       Int
  unitPriceCents Int
  unitCostCents  Int       @default(0)
  lineTotalCents Int
  offerId        String
  productId      String?
  materialId     String?
  offer          Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  material       Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([materialId])
}

model Invoice {
  id                  String              @id @default(cuid())
  number              String              @unique
  status              InvoiceStatus       @default(UNPAID)
  notes               String?
  subtotalCents       Int
  vatEnabled          Boolean             @default(true)
  vatRate             Float               @default(18)
  vatAmountCents      Int
  totalCents          Int
  amountPaidCents     Int                 @default(0)
  dueDate             DateTime
  issuedAt            DateTime            @default(now())
  paidAt              DateTime?
  inventoryDeductedAt DateTime?
  clientId            String
  offerId             String?             @unique
  client              Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  offer               Offer?              @relation(fields: [offerId], references: [id], onDelete: SetNull)
  items               InvoiceItem[]
  movements           InventoryMovement[]
  debitNotes          DebitNote[]

  @@index([status, dueDate])
  @@index([issuedAt])
  @@index([dueDate])
  @@index([totalCents])
  @@index([clientId, issuedAt])
}

model InvoiceItem {
  id             String          @id @default(cuid())
  productName    String
  description    String?
  quantity       Int
  unitPriceCents Int
  unitCostCents  Int             @default(0)
  lineTotalCents Int
  invoiceId      String
  productId      String?
  materialId     String?
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  material       Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  debitNoteItems DebitNoteItem[]

  @@index([invoiceId])
  @@index([materialId])
  @@index([productName])
}

model PurchaseInvoice {
  id                   String                @id @default(cuid())
  number               String                @unique
  status               InvoiceStatus         @default(UNPAID)
  notes                String?
  subtotalCents        Int
  vatEnabled           Boolean               @default(true)
  vatRate              Float                 @default(18)
  vatAmountCents       Int
  totalCents           Int
  amountPaidCents      Int                   @default(0)
  dueDate              DateTime
  issuedAt             DateTime              @default(now())
  paidAt               DateTime?
  inventoryRestockedAt DateTime?
  supplierId           String
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items                PurchaseInvoiceItem[]
  movements            InventoryMovement[]

  @@index([status, dueDate])
  @@index([supplierId])
  @@index([issuedAt])
  @@index([dueDate])
  @@index([totalCents])
  @@index([supplierId, issuedAt])
}

model PurchaseInvoiceItem {
  id                String          @id @default(cuid())
  productName       String
  description       String?
  quantity          Int
  unitPriceCents    Int
  lineTotalCents    Int
  purchaseInvoiceId String
  materialId        String?
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  material          Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([purchaseInvoiceId])
  @@index([materialId])
}

model DeliveryNote {
  id         String             @id @default(cuid())
  number     String             @unique
  type       DeliveryNoteType
  status     DeliveryNoteStatus @default(DRAFT)
  notes      String?
  issuedAt   DateTime           @default(now())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  clientId   String?
  supplierId String?
  client     Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  supplier   Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items      DeliveryNoteItem[]

  @@index([type, status, issuedAt])
  @@index([status, issuedAt])
  @@index([issuedAt])
  @@index([type, issuedAt])
  @@index([clientId])
  @@index([supplierId])
}

model DeliveryNoteItem {
  id             String       @id @default(cuid())
  productName    String
  description    String?
  quantity       Int
  deliveryNoteId String
  materialId     String?
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  material       Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([deliveryNoteId])
  @@index([materialId])
}

model Expense {
  id             String          @id @default(cuid())
  name           String
  category       ExpenseCategory
  amountCents    Int
  vatEnabled     Boolean         @default(true)
  vatRate        Float           @default(18)
  vatAmountCents Int
  totalCents     Int
  date           DateTime
  supplierName   String?
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([category, date])
  @@index([date])
  @@index([name])
  @@index([supplierName])
  @@index([supplierName, date])
  @@index([totalCents])
}

model DebitNote {
  id             String          @id @default(cuid())
  number         String          @unique
  reason         DebitNoteReason
  notes          String?
  subtotalCents  Int
  vatEnabled     Boolean         @default(true)
  vatRate        Float           @default(18)
  vatAmountCents Int
  totalCents     Int
  issuedAt       DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  clientId       String
  invoiceId      String
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  items          DebitNoteItem[]

  @@index([clientId, issuedAt])
  @@index([invoiceId])
  @@index([issuedAt])
  @@index([reason, issuedAt])
  @@index([totalCents])
}

model DebitNoteItem {
  id             String       @id @default(cuid())
  productName    String
  description    String?
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  debitNoteId    String
  invoiceItemId  String?
  debitNote      DebitNote    @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  invoiceItem    InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([debitNoteId])
  @@index([invoiceItemId])
}

model InventoryMovement {
  id                String                @id @default(cuid())
  kind              InventoryMovementKind
  quantity          Float
  note              String?
  createdAt         DateTime              @default(now())
  materialId        String
  invoiceId         String?
  purchaseInvoiceId String?
  material          Material              @relation(fields: [materialId], references: [id], onDelete: Cascade)
  invoice           Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  purchaseInvoice   PurchaseInvoice?      @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([materialId, createdAt])
  @@index([invoiceId])
  @@index([purchaseInvoiceId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  href      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead, createdAt])
  @@index([createdAt])
}

model Worker {
  id        String            @id @default(cuid())
  name      String
  role      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  entries   WorkerTimeEntry[]
  advances  WorkerAdvance[]

  @@index([name])
  @@index([role, name])
  @@index([createdAt])
}

model WorkerTimeEntry {
  id         String   @id @default(cuid())
  workerId   String
  startedAt  DateTime
  finishedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([startedAt])
  @@index([workerId])
}

model WorkerAdvance {
  id          String   @id @default(cuid())
  workerId    String
  date        DateTime
  amountCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([workerId])
}
